# ============================================================
# TutorSetu - Environment Configuration Example
# ============================================================

# Copy this file to .env for local development.
# NEVER put real secrets in this file.

# ============================================================
# Django Core
# ============================================================

# Generate a strong random value for production.
DJANGO_SECRET_KEY=

# Local development
DJANGO_DEBUG=True

# Comma-separated hosts
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production example:
# DJANGO_ALLOWED_HOSTS=tutorsetu.com,www.tutorsetu.com

# Production HTTPS origins
# Example:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tutorsetu.com,https://www.tutorsetu.com
DJANGO_CSRF_TRUSTED_ORIGINS=


# ============================================================
# Database
# ============================================================

# Leave empty to use local SQLite.
#
# Production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=


# ============================================================
# Email / Brevo SMTP
# ============================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=True

# Use a sender verified in Brevo.
DEFAULT_FROM_EMAIL=TutorSetu <your-verified-email@example.com>


# ============================================================
# Admin Seed
# ============================================================

SEED_ADMIN_EMAIL=admin@tutorsetu.local

# NEVER put the real admin password here.
SEED_ADMIN_PASSWORD=


# ============================================================
# Production Notes
# ============================================================

# Production should use:
#
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=tutorsetu.com,www.tutorsetu.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tutorsetu.com,https://www.tutorsetu.com
# DATABASE_URL=<production-postgresql-url>
#
# Configure production secrets through the hosting provider.
#
# NEVER commit:
# - .env
# - real DJANGO_SECRET_KEY
# - SMTP passwords/keys
# - database passwords
# - admin passwords
# - private verification documents

